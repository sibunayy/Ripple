{
  "name": "rippleflow",
  "version": "0.0.0",
  "private": true,
  "description": "RippleFlow: a motion design editor for iPad Safari",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:parity": "playwright test",
    "test:parity:app": "node scripts/with-env.mjs RF_TARGET=app playwright test",
    "test:parity:update": "playwright test --update-snapshots",
    "lint": "eslint src",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
